{
  "version": 2,
  "routes": [
    {
      "src": "^/assets/.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/dicts/.*",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "outputDirectory": "dist"
}
